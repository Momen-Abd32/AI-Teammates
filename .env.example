NODE_ENV=development
POSTGRES_DB=ai_teammates
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_teammates
REDIS_URL=redis://localhost:6379
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
API_PORT=3001
AGENT_SERVICE_URL=http://localhost:8000
WEB_PORT=3000
DEVICE_WS_URL=ws://localhost:3001/device
DEVICE_TOKEN=
DEVICE_WORKSPACE=.
DEVICE_ALLOWED_ACTIONS=device.files.read
DEVICE_MAX_FILE_BYTES=2097152
DEVICE_MAX_COMMAND_OUTPUT_BYTES=1048576
DEVICE_COMMAND_TIMEOUT_MS=30000
DEVICE_ALLOWED_COMMANDS=node,npm,pnpm,npx,python,python3,git
DEVICE_BROWSER_CDP_URL=http://127.0.0.1:9222
DEVICE_MAX_SCREENSHOT_BYTES=5242880
# Optional per-agent local policy. Keys are agent IDs.
# DEVICE_AGENT_POLICIES={"agent-id":{"enabled":true,"allowedActions":["device.files.read"]}}

AUTH_SECRET=replace-with-a-long-random-secret
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_ALLOWED_REPOS=
SANDBOX_WORKER_URL=http://localhost:8010
